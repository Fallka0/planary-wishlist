# Frontend (Vite, baked in at build time). The API's settings are in worker/wrangler.jsonc, and
# for local development in worker/.dev.vars (see worker/.dev.vars.example).

# Where sign-in lives. Defaults to https://auth.planary.ch. Its ALLOWED_RETURN_TO_ORIGINS must
# include this app's origin (wishlist.planary.ch, and your local dev origin) or sign-in can't return.
VITE_AUTH_BASE_URL=
# Where the API lives. Defaults to the same origin, which is how it's deployed.
VITE_API_BASE_URL=
