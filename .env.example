# ── Go API (Vercel functions and `npm run api:dev`) ──
# Postgres. Migrations in pkg/db/migrations run automatically on the first request.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# planary-auth, which signs people in. The API confirms bearer tokens with its /api/auth/me.
# Defaults to https://auth.planary.ch.
AUTH_API_URL=

# Base URL for share links (/w/<token>) and invite links (/invite/<token>).
# Falls back to the request's own host, which is fine locally and on preview deployments.
PUBLIC_APP_URL=https://wishlist.planary.ch
# Optional: email delivery for co-planner invites and guests' undo links (Resend).
# Unset = no email; the app shows and copies the links instead.
RESEND_API_KEY=
MAIL_FROM=Planary <noreply@planary.ch>

# Optional: a Postgres database for integration tests (`go test ./...`). The tests create and
# drop their own temporary databases, so the user needs CREATEDB. Tests are skipped when unset.
DATABASE_URL_TEST=

# ── Frontend (Vite, baked in at build time) ──
# Where sign-in lives. Defaults to https://auth.planary.ch. Its ALLOWED_RETURN_TO_ORIGINS must
# include this app's origin (wishlist.planary.ch, and your local dev origin) or sign-in can't return.
VITE_AUTH_BASE_URL=
# Where the API lives. Defaults to the same origin.
VITE_API_BASE_URL=
