{
  "name": "planary-wishlist-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../dist && wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply planary-wishlist --local",
    "db:migrate": "wrangler d1 migrations apply planary-wishlist --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
