{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves wishlist.planary.ch: the web app's files and the API under /api.
  "name": "planary-wishlist",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // The web app, built by `npm run build` in the repo root. Requests for /api/* reach the Worker;
  // everything else is a file from dist, or index.html for the app's own routes.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: the first deploy creates the database, later commands find it by name.
  "d1_databases": [{ "binding": "DB", "database_name": "planary-wishlist", "migrations_dir": "migrations" }],
  // Checks sign-in tokens by asking planary-auth directly, worker to worker.
  "services": [
    { "binding": "AUTH", "service": "planary-auth" },
    // Which Planary organisations (that use Wishlist) a person is on, for organisation wishlists.
    { "binding": "ORG", "service": "planary-org" }
  ],
  // The zone is named because Cloudflare can't always infer it for a custom domain (error 10082).
  "routes": [{ "pattern": "wishlist.planary.ch", "custom_domain": true, "zone_name": "planary.ch" }],
  "vars": {
    // Base for share links (/w/<token>) and invite links (/invite/<token>).
    "PUBLIC_APP_URL": "https://wishlist.planary.ch",
    "MAIL_FROM": "Planary <noreply@planary.ch>"
  },
  "observability": { "enabled": true }
}
